# =============================================================================
# SecureNet Lab — Configuration
# Copy this file to config.env and fill in your values.
# =============================================================================

# -- Target Server (Rocky Linux VM) -------------------------------------------
TARGET_IP=192.168.56.20
SSH_USER=your_username
SSH_PORT=22
SSH_KEY_PATH=/home/monitor/.ssh/id_rsa

# -- Log Collection Paths (on target server) ----------------------------------
# APACHE_LOG_PATH=/var/log/httpd/access_log
# SSHD_LOG_PATH=/var/log/secure
# MAIL_LOG_PATH=/var/log/maillog
# COLLECT_INTERVAL=10

# -- Detection Thresholds -----------------------------------------------------
# BRUTE_FORCE_THRESHOLD=5
# PORT_SCAN_THRESHOLD=20
# WEB_ENUM_THRESHOLD=10
# DETECTION_WINDOW=300

# -- Threat Intelligence (AbuseIPDB) ------------------------------------------
ABUSEIPDB_API_KEY=your_key_here
# ABUSEIPDB_CACHE_TTL=3600
# ABUSEIPDB_MIN_SCORE=50.0

# -- Auto-Ban -----------------------------------------------------------------
# AUTO_BAN_ENABLED=true
# BAN_DURATION=3600
# FIREWALL_BACKEND=firewalld

# -- Alerts — Telegram --------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# -- Alerts — Email -----------------------------------------------------------
SMTP_HOST=192.168.56.20
SMTP_PORT=25
ALERT_FROM=monitor@local
ALERT_TO=admin@local

# -- REST API -----------------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# -- Logging ------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE_ENABLED=true
