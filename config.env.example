# =============================================================================
# SecureNet Lab — Configuration
# Copy this file to config.env and fill in your values.
# To keep it elsewhere, set SECURENET_CONFIG=/path/to/file instead.
# =============================================================================

# -- Target Server (Rocky Linux VM) -------------------------------------------
TARGET_IP=192.168.56.20
SSH_USER=your_username
SSH_PORT=22
SSH_KEY_PATH=/home/monitor/.ssh/id_rsa

# -- Log Collection Paths (on target server) ----------------------------------
# APACHE_LOG_PATH=/var/log/httpd/access_log
# SSHD_LOG_PATH=/var/log/secure
# MAIL_LOG_PATH=/var/log/maillog
# COLLECT_INTERVAL=10
# Rocky keeps /var/log/secure and /var/log/httpd root-only. setup_target.sh
# installs a read-only helper the SSH user may run via sudo; enable it here:
# LOG_READ_HELPER=/usr/local/sbin/securenet-logread

# -- Detection Thresholds -----------------------------------------------------
# BRUTE_FORCE_THRESHOLD=5
# PORT_SCAN_THRESHOLD=20
# WEB_ENUM_THRESHOLD=10
# DETECTION_WINDOW=300

# -- Suricata IDS (on the target server) --------------------------------------
# SURICATA_ENABLED=true
# SURICATA_EVE_PATH=/var/log/suricata/eve.json

# -- Threat Intelligence (AbuseIPDB) ------------------------------------------
ABUSEIPDB_API_KEY=your_key_here
# ABUSEIPDB_CACHE_TTL=3600
# ABUSEIPDB_MIN_SCORE=50.0

# -- Auto-Ban -----------------------------------------------------------------
# AUTO_BAN_ENABLED=true
# BAN_DURATION=3600
# FIREWALL_BACKEND=firewalld
# IPs/CIDRs that must never be banned, even if spoofed in an attack.
# Loopback and TARGET_IP are always protected. Add this monitor VM and
# the VirtualBox host, or a spoofed scan can make the pipeline lock
# itself out of the target.
# NEVER_BAN=192.168.56.1,192.168.56.30

# -- Alerts — Telegram --------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# -- Alerts — Email -----------------------------------------------------------
SMTP_HOST=192.168.56.20
SMTP_PORT=25
ALERT_FROM=monitor@local
ALERT_TO=admin@local

# -- REST API -----------------------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# -- Logging ------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE_ENABLED=true
